---
layout: base.njk
title: "Wenxi's Blog"
description: "A site for my technical thoughts and ideas evolved around AI technology."
---

<div class="home">
  <h1 class="page-heading">Posts</h1>

  <ul class="post-list">
    {% for item in collections.postsListed | combinedFeed(substack) %}
    <li>
      <span class="post-meta">
        <time datetime="{{ item.date | isoDate }}">{{ item.date | dateDisplay }}</time>
        {%- if item.type == "post" and item.post.data.date | showUpdated(item.post.data.updated) %}
        <span class="post-updated">
          · Updated <time datetime="{{ item.post.data.updated | isoDate }}">{{ item.post.data.updated | dateDisplay }}</time>
        </span>
        {%- endif %}
        {%- if item.type == "post" %}
          {%- set partner = collections.posts | findTranslation(item.post.data.translation_key, item.post.data.lang) -%}
          {%- if partner %}
          <span class="lang-badge" title="Translation available">中/EN</span>
          {%- endif %}
        {%- elif item.type == "substack" %}
          <span class="substack-badge" title="Published on Substack">Substack</span>
        {%- endif %}
        {%- if item.tags and item.tags.length %}
        <span class="post-tags">
          {%- for tag in item.tags %}
          <span class="tag-badge tag-{{ tag | tagSlug }}">{{ tag }}</span>
          {%- endfor %}
        </span>
        {%- endif %}
      </span>
      <h2>
        {%- if item.type == "substack" %}
        <a class="post-link" href="{{ item.url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
        {%- else %}
        <a class="post-link" href="{{ item.url }}">{{ item.title }}</a>
        {%- endif %}
      </h2>
    </li>
    {% endfor %}
  </ul>

  <p class="rss-subscribe">subscribe <a href="/feed.xml">via RSS</a></p>
</div>

