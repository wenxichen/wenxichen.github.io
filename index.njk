---
layout: base.njk
title: "Wenxi's Blog"
description: "A site for my technical thoughts and ideas evolved around AI technology."
---

<div class="home">
  <h1 class="page-heading">Posts</h1>

  <ul class="post-list">
    {% for post in collections.postsListed %}
    <li>
      <span class="post-meta">
        {{ post.date | dateDisplay }}
        {%- set partner = collections.posts | findTranslation(post.data.translation_key, post.data.lang) -%}
        {%- if partner %}
        <span class="lang-badge" title="Translation available">中/EN</span>
        {%- endif %}
      </span>
      <h2>
        <a class="post-link" href="{{ post.url }}">{{ post.data.title }}</a>
      </h2>
    </li>
    {% endfor %}
  </ul>

  <p class="rss-subscribe">subscribe <a href="/feed.xml">via RSS</a></p>
</div>

