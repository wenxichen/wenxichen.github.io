---
layout: base.njk
---

<article class="post">
  <header class="post-header">
    <h1 class="post-title">{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | isoDate }}">
        {{ date | dateDisplay }}
      </time>
    </p>
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>
</article>

